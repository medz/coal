# fish completion for coaltest -*- shell-script -*-
#----------------------------------------
# This file is generated by the Coal TAB.
#----------------------------------------
# Date: <generated>
#----------------------------------------

# Define shell completion directives
set -l ShellCompDirectiveError 1
set -l ShellCompDirectiveNoSpace 2
set -l ShellCompDirectiveNoFileComp 4
set -l ShellCompDirectiveFilterFileExt 8
set -l ShellCompDirectiveFilterDirs 16
set -l ShellCompDirectiveKeepOrder 32

function __coaltest_debug
    set -l file "$BASH_COMP_DEBUG_FILE"
    if test -n "$file"
        echo "$argv" >> $file
    end
end

function __coaltest_perform_completion
    __coaltest_debug "Starting __coaltest_perform_completion"

    # Extract all args and the current token.
    set -l args (commandline -opc)
    set -l last_arg (commandline -ct)

    __coaltest_debug "Args: $args"
    __coaltest_debug "Last arg: $last_arg"

    # Call the completion program and get the results
    set -l requestComp '/usr/bin/dart' '/path/to/testcli' complete --
    for arg in $args[2..-1]
        set -a requestComp "$arg"
    end
    if test -z "$last_arg"
        set -a requestComp ""
    else
        set -a requestComp "$last_arg"
    end
    __coaltest_debug "Calling $requestComp"
    set -l results ($requestComp 2> /dev/null)

    # Some programs may output extra empty lines after the directive.
    # Let's ignore them or else it will break completion.
    # Ref: https://github.com/spf13/cobra/issues/1279
    for line in $results[-1..1]
        if test (string trim -- $line) = ""
            set results $results[1..-2]
        else
            break
        end
    end

    # No completions, let fish handle file completions.
    if test (count $results) -eq 0
        __coaltest_debug "No completions, performing file completion"
        return 1
    end

    # Parse directive line.
    set -l directive_num 0
    if test (string sub -s 1 -l 1 -- $results[-1]) = ":"
        set -l directive (string sub -s 2 -- $results[-1])
        if test -n "$directive"
            set directive_num (math $directive)
        end
        set results $results[1..-2]
    end

    # For fish, when completing a flag with an = (e.g., --name=<TAB>)
    # completions must be prefixed with the flag.
    set -l flag_prefix (string match -r -- '-.*=' "$last_arg")

    __coaltest_debug "Directive: $directive_num"
    __coaltest_debug "Completions: $results"
    __coaltest_debug "Flag prefix: $flag_prefix"

    # Process completions based on directive
    if test (math "$directive_num & $ShellCompDirectiveError") -ne 0
        # Error code. No completion.
        __coaltest_debug "Received error directive: aborting."
        return 1
    end

    # No completions, let fish handle file completions unless forbidden
    if test (count $results) -eq 0
        if test (math "$directive_num & $ShellCompDirectiveNoFileComp") -eq 0
            __coaltest_debug "No completions, performing file completion"
            return 1
        end
        __coaltest_debug "No completions, but file completion forbidden"
        return 0
    end

    # Fish doesn't support extension or directory filtering directives.
    if test (math "$directive_num & $ShellCompDirectiveFilterFileExt") -ne 0; or test (math "$directive_num & $ShellCompDirectiveFilterDirs") -ne 0
        __coaltest_debug "File extension filtering or directory filtering not supported"
        return 1
    end

    # Process remaining completions
    for item in $results
        if test -n "$item"
            # Check if the item has a description
            if string match -q "*	*" -- "$item"
                set -l completion_parts (string split --max 1 	 -- "$item")
                set -l comp $completion_parts[1]
                set -l desc $completion_parts[2]

                # Add the completion and description
                echo -e "$flag_prefix$comp	$desc"
            else
                # Add just the completion
                echo -e "$flag_prefix$item	"
            end
        end
    end

    # If directive contains NoSpace, tell fish not to add a space after completion
    if test (math "$directive_num & $ShellCompDirectiveNoSpace") -ne 0
        return 2
    end

    return 0
end

# Set up the completion for the coaltest command
complete -c coaltest -f -a "(eval __coaltest_perform_completion)"
